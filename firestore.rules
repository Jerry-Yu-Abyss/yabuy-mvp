rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 共用函式：是否為管理員（讀 token claim，最可信）
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /audit_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;

      // 更新規則：三種情況之一才允許
      allow update: if request.auth != null && (
        // (1) 本人改自己，但不可自行竄改 isAdmin / isFounder
        (
          request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['isAdmin', 'isFounder'])
        )
        // (2) 任何登入者只能累加評分彙總這兩個欄位
        || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ratingSum', 'ratingCount'])
        // (3) 管理員可改他人狀態（拉黑/解除），但不可停權創辦人、也不可改 isAdmin/isFounder
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status'])
          && !(resource.data.get('isFounder', false) == true
               && request.resource.data.status == 'banned')
        )
      );

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      // 擁有者可改自己的商品；管理員可管理任何商品（巡邏/清除用）
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    match /favorites/{favId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{notifId} {
      // 一般人可讀（首頁公告）；建立/刪除限管理員（發/收公告）
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
    }

    match /reviews/{id} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.raterId;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 罐頭訊息（新交易流程的面交前即時協調）。跟 orders/favorites 同一套
    // 寬鬆風格：任何登入者可讀寫，不逐欄位驗證寄件人／訂單歸屬。
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }
  }
}
