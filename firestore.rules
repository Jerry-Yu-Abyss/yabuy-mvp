rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 共用函式：是否為管理員（讀 token claim，最可信）
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // 共用函式：是否為某筆訂單的當事人（買家或賣家）。
    // messages 文件本身沒存 buyerId/sellerId，要回頭查 orders 才知道誰有資格看。
    function isOrderParty(orderId) {
      let o = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return request.auth.uid == o.buyerId || request.auth.uid == o.sellerId;
    }

    // 稽核紀錄：一般使用者發起交易時會寫入一筆（TradeModal.vue），管理員的操作
    // 也會寫入（Admin.vue）；但內容含交易糾紛細節、操作對象等敏感資訊，只有
    // 管理員能讀。維持唯讀性質：任何人都不能事後竄改或刪除已寫入的紀錄。
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /users/{uid} {
      // email 等個資只給登入者看（原本 if true 讓沒登入的人也能撈到全站 email
      // 清單），一般瀏覽（首頁商品等）本來就不靠讀這個 collection，不受影響。
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;

      // 更新規則：三種情況之一才允許
      allow update: if request.auth != null && (
        // (1) 本人改自己，但不可自行竄改 isAdmin / isFounder
        (
          request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['isAdmin', 'isFounder'])
        )
        // (2) 任何登入者只能累加評分彙總這兩個欄位
        || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ratingSum', 'ratingCount'])
        // (3) 管理員可改他人狀態（拉黑/解除），但不可停權創辦人、也不可改 isAdmin/isFounder
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status'])
          && !(resource.data.get('isFounder', false) == true
               && request.resource.data.status == 'banned')
        )
      );

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      // 擁有者可改自己的商品；管理員可管理任何商品（巡邏/清除用）。
      // create 額外驗證 sellerId 一定是建立者本人，避免有人冒名替別人上架商品。
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      // 這筆訂單的當事人（買家或賣家）
      function isParty() {
        return request.auth.uid == resource.data.buyerId ||
               request.auth.uid == resource.data.sellerId;
      }

      // 買賣雙方身分與商品不可事後變更，否則等同整筆訂單被挾持
      // （例：把 sellerId 改成自己，就能把別人談好的交易據為己有）
      function immutablePartiesKept() {
        return request.resource.data.get('buyerId', '') == resource.data.get('buyerId', '')
            && request.resource.data.get('sellerId', '') == resource.data.get('sellerId', '')
            && request.resource.data.get('productId', '') == resource.data.get('productId', '');
      }

      // 改期次數上限：賣家 1 次、買家 2 次。
      // 原本這條**只在 Mailbox.vue 前端擋**，繞過前端直接打 REST 就能把
      // negotiationStep 設成任意值、無限改期。規則層只接受兩種情況：
      //   (1) 這次更新根本沒動 negotiationStep（接受/婉拒/就緒/成交等都屬此類）
      //   (2) 剛好 +1，且該角色的既有次數還沒用完
      function negotiationStepOk() {
        let prev = resource.data.get('negotiationStep', 0);
        let next = request.resource.data.get('negotiationStep', prev);
        return next == prev
            || (next == prev + 1
                && (request.auth.uid == resource.data.sellerId ? prev < 1 : prev < 2));
      }

      // 只有這筆訂單的買家、賣家、或管理員能看到／動到——原本任何登入者都能
      // 讀寫任何一筆訂單，等於別人的面交時間地點、價格全部攤在陽光下。
      allow read: if request.auth != null && (isParty() || isAdmin());

      // 建立時一定是買家本人發起（TradeModal.vue 一律把 buyerId 設成 auth.uid）。
      // buyerId != sellerId 這條原本也只在 TradeModal.vue 前端擋，繞過前端就能
      // 自買自賣，污染排行榜與貢獻度統計。
      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId != request.resource.data.sellerId;

      allow update: if request.auth != null && (
        isAdmin()
        || (isParty() && immutablePartiesKept() && negotiationStepOk())
      );

      // 目前沒有任何地方會刪除訂單，不開放
      allow delete: if false;
    }

    match /favorites/{favId} {
      // 只有本人能看到／動到自己的收藏——原本任何登入者都能讀寫任何人的收藏清單
      allow read, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow update: if false; // 沒有地方會更新收藏，只有新增/刪除
    }

    match /notifications/{notifId} {
      // 一般人可讀（首頁公告）；建立/刪除限管理員（發/收公告）
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
    }

    match /reviews/{id} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.raterId;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 罐頭訊息（新交易流程的面交前即時協調）。訊息本身沒存買賣雙方 uid，
    // 靠 isOrderParty() 回頭查 orders 判斷讀寫資格——只有這筆訂單的買家/賣家
    // 能看到、能發言，原本任何登入者都能讀寫任何一筆訊息。
    match /messages/{messageId} {
      allow read: if request.auth != null && isOrderParty(resource.data.orderId);
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && isOrderParty(request.resource.data.orderId);
      allow update, delete: if false;
    }

    // 廣告投放：首頁未登入也看得到（跟 products 一樣公開可讀），
    // 只有管理員能新增/修改/刪除廣告內容與上下架期限。
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
