rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 共用函式：是否為管理員（讀 token claim，最可信）
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // 共用函式：是否為某筆訂單的當事人（買家或賣家）。
    // messages 文件本身沒存 buyerId/sellerId，要回頭查 orders 才知道誰有資格看。
    function isOrderParty(orderId) {
      let o = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return request.auth.uid == o.buyerId || request.auth.uid == o.sellerId;
    }

    // 稽核紀錄：一般使用者發起交易時會寫入一筆（TradeModal.vue），管理員的操作
    // 也會寫入（Admin.vue）；但內容含交易糾紛細節、操作對象等敏感資訊，只有
    // 管理員能讀。維持唯讀性質：任何人都不能事後竄改或刪除已寫入的紀錄。
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // 🚧 交易功能維護中：管理端的緊急煞車（settings/trade.maintenance）。
    // 系統出錯時把所有會推進交易狀態的寫入一次擋掉，讓錯誤不再擴散。
    //
    // 為什麼在規則層而不是只擋前端：前端擋得住的只有「按鈕按不下去」，繞過
    // 前端直接打 REST 照樣寫得進去——那樣的煞車在真的出事時等於沒有。
    //
    // 讀不到 settings 文件時視為沒有維護（fail-open）：這個開關預設不存在，
    // 不能因為一份還沒建立的文件把全站交易鎖死。
    function inMaintenance() {
      let path = /databases/$(database)/documents/settings/trade;
      return exists(path) && get(path).data.get('maintenance', false) == true;
    }

    match /users/{uid} {
      // email 等個資只給登入者看（原本 if true 讓沒登入的人也能撈到全站 email
      // 清單），一般瀏覽（首頁商品等）本來就不靠讀這個 collection，不受影響。
      allow read: if request.auth != null;
      // create 原本沒有任何欄位限制（見 docs/wiki/已知問題.md 第 9 條）。這裡
      // 至少先把爽約欄位堵住：還沒有 users 文件的人若能自己建一份帶
      // expireCount: 0 的文件，等於憑空清掉紀錄。update 那條擋得住既有文件，
      // 擋不住「先建一份乾淨的」這條路。
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['expireCount', 'expirePeriodStart',
                                                 'noReplyCount', 'noReplyPeriodStart',
                                                 'cancelCount', 'cancelPeriodStart']);

      // 更新規則：兩種情況之一才允許
      //
      // ⚠️ 曾經有第三種：「任何登入者只要 hasOnly(['ratingSum','ratingCount'])
      // 就放行」。那條沒有限制對象、也沒有限制數值，等於任何人都能對任意 uid
      // 把評分設成任意值——自己刷成滿分、或把競爭對手刷成 0 分，完全不需要跟
      // 對方交易過（Deal.vue 用 increment() 只是前端自律，規則並不強制）。
      // 現在 ratingSum / ratingCount 前端一律不可寫，改由 Cloud Function
      // onReviewCreated 以 Admin SDK 累加，來源是通過驗證的 reviews 文件。
      allow update: if request.auth != null && (
        // (1) 本人改自己，但不可自行竄改 isAdmin / isFounder / 評分彙總
        (
          request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['isAdmin', 'isFounder', 'ratingSum', 'ratingCount',
                         'expireCount', 'expirePeriodStart',
                         'noReplyCount', 'noReplyPeriodStart',
                         'cancelCount', 'cancelPeriodStart'])
        )
        // (2) 管理員可改他人狀態（拉黑/解除），但不可停權創辦人、也不可改 isAdmin/isFounder
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status'])
          && !(resource.data.get('isFounder', false) == true
               && request.resource.data.status == 'banned')
        )
      );

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      // 擁有者可改自己的商品；管理員可管理任何商品（巡邏/清除用）。
      // create 額外驗證 sellerId 一定是建立者本人，避免有人冒名替別人上架商品。
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      // 發起交易的閘門：30 天內被記滿 3 次的人不能再發起新交易，週期過完自動
      // 恢復（不需要人工解鎖）。三組次數都由 Cloud Function 以 Admin SDK 寫入
      // （onOrderExpired 寫前兩組、onOrderCancelled 寫 cancelCount），users.update
      // 已把六個欄位列入本人不可竄改的清單——否則只要把數字改回 0 就能繞過閘門。
      //
      // 沒有 users 文件的舊帳號（backfillUserDocs 的存在證明確實有）不該被
      // 誤擋，所以週期起點取不到時用 2000-01-01 當預設：那個週期早就過完，
      // 條件必定為 false。
      function notTradeBanned() {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        let u = exists(path) ? get(path).data : {};
        let expStart = u.get('expirePeriodStart', timestamp.date(2000, 1, 1));
        let repStart = u.get('noReplyPeriodStart', timestamp.date(2000, 1, 1));
        let canStart = u.get('cancelPeriodStart', timestamp.date(2000, 1, 1));
        // 三種紀錄分開計數、各自 3 次，但踩到任一條的後果一樣：暫時不能發起新交易。
        //   expireCount  —— 約好了卻沒出現（accepted 逾期，且只有一方沒按安全交易）
        //   noReplyCount —— 收到請求後從頭到尾沒回應（pending / negotiating 逾期）
        //   cancelCount  —— 自己主動把談好或談到一半的交易取消掉
        return !(u.get('expireCount', 0) >= 3
                 && request.time < expStart + duration.value(30, 'd'))
            && !(u.get('noReplyCount', 0) >= 3
                 && request.time < repStart + duration.value(30, 'd'))
            && !(u.get('cancelCount', 0) >= 3
                 && request.time < canStart + duration.value(30, 'd'));
      }

      // 這筆訂單的當事人（買家或賣家）
      function isParty() {
        return request.auth.uid == resource.data.buyerId ||
               request.auth.uid == resource.data.sellerId;
      }

      // 買賣雙方身分與商品不可事後變更，否則等同整筆訂單被挾持
      // （例：把 sellerId 改成自己，就能把別人談好的交易據為己有）
      function immutablePartiesKept() {
        return request.resource.data.get('buyerId', '') == resource.data.get('buyerId', '')
            && request.resource.data.get('sellerId', '') == resource.data.get('sellerId', '')
            && request.resource.data.get('productId', '') == resource.data.get('productId', '');
      }

      // 改期次數上限：賣家 1 次、買家 2 次。
      // 原本這條**只在 Mailbox.vue 前端擋**，繞過前端直接打 REST 就能把
      // negotiationStep 設成任意值、無限改期。規則層只接受兩種情況：
      //   (1) 這次更新根本沒動 negotiationStep（接受/婉拒/就緒/成交等都屬此類）
      //   (2) 剛好 +1，且該角色的既有次數還沒用完
      function negotiationStepOk() {
        let prev = resource.data.get('negotiationStep', 0);
        let next = request.resource.data.get('negotiationStep', prev);
        return next == prev
            || (next == prev + 1
                && (request.auth.uid == resource.data.sellerId ? prev < 1 : prev < 2));
      }

      // 「希望推遲面交時間」額度：買家 1 次、賣家 1 次，各自獨立，與改期
      // （negotiationStep）分開計算。比照 negotiationStepOk 在規則層強制——
      // 只在前端擋的話，繞過就能無限發推遲請求把約定時間一路往後推，
      // 等於繞過逾期關閉機制、把商品無限期綁在一筆訂單上。
      // 旗標只能 false → true，而且只有本人能立自己那一支。
      function delayUsedOk() {
        let pb = resource.data.get('buyerDelayUsed', false);
        let nb = request.resource.data.get('buyerDelayUsed', pb);
        let ps = resource.data.get('sellerDelayUsed', false);
        let ns = request.resource.data.get('sellerDelayUsed', ps);
        return (nb == pb
                || (pb == false && nb == true
                    && request.auth.uid == resource.data.buyerId))
            && (ns == ps
                || (ps == false && ns == true
                    && request.auth.uid == resource.data.sellerId));
      }

      // 賣家必須真的是這件商品的擁有者。原本沒驗，代表可以隨手抓一個路人的
      // uid 當 sellerId 大量建單（對方信箱同時被塞爆），再配合下面的
      // statusFlowOk 一路改成 completed，一個人就能灌爆排行榜與首頁公開統計。
      function sellerOwnsProduct(pid) {
        return exists(/databases/$(database)/documents/products/$(pid))
            && get(/databases/$(database)/documents/products/$(pid))
                 .data.get('sellerId', '') == request.resource.data.sellerId;
      }

      // 訂單狀態機（見 docs/wiki/交易生命週期.md）。原本規則層完全不管 status，
      // 買家可以自己把訂單一路改成 completed、成交價填天文數字，而
      // getRankingStats / getPublicStats 都是直接讀 orders 算出來的——等於
      // 排行榜、循環利用金額、首頁「已流通件數」全部可被單方面偽造。
      // 這裡把合法轉移列成白名單，關鍵是 completed 只有賣家能按（對應
      // Deal.vue 的 seller-confirm-price 畫面，買家單方面成交不了）。
      function statusFlowOk() {
        let prev = resource.data.get('status', '');
        let next = request.resource.data.get('status', prev);
        return next == prev
            // 改提案／接受／婉拒／取消：pending 與 negotiating 階段雙方都能操作
            // 改提案／接受／婉拒／取消，或「約定時間過了都沒人回應」的逾期
            || ((prev == 'pending' || prev == 'negotiating')
                && (next == 'negotiating' || next == 'accepted'
                    || next == 'rejected' || next == 'expired'))
            // 面交中：任一方都能取消或判定失敗，或以「逾期」結案。
            // expired 的 30 分鐘判定在 Mailbox.vue，規則層算不出來——orders.time
            // 是不含時區的 "YYYY-MM-DD HH:mm" 字串（見 docs/wiki/新交易流程規格.md
            // 風險 2），rules 沒有字串轉時間的手段。這裡只保證「終點合法」：
            // 只有 accepted 能變 expired，且 expired 之後誰也改不動。
            || (prev == 'accepted'
                && (next == 'rejected' || next == 'failed' || next == 'expired'))
            // 成交：限賣家確認，且買家必須已填過有效成交價
            || (prev == 'accepted' && next == 'completed'
                && request.auth.uid == resource.data.sellerId
                && resource.data.get('finalPrice', 0) is number
                && resource.data.get('finalPrice', 0) > 0);
        // completed / rejected / failed 是終止態：只剩 next == prev 會過
      }

      // 轉成 rejected 時，lastActionBy 必須誠實標成操作者本人。
      // onOrderCancelled 靠它決定要把取消記給誰，以及這是不是「賣家婉拒一筆還
      // 沒談成的請求」（那種不記次）。沒有這條的話，取消的人把 lastActionBy 寫
      // 成對方就能讓自己的額度不動、還把一次取消記到對方頭上；不寫的話則會沿用
      // 協商階段留下的舊值，同樣記錯人。
      function cancelActorOk() {
        let prev = resource.data.get('status', '');
        let next = request.resource.data.get('status', prev);
        // 已經是 rejected 的訂單不再檢查：那是終止態，trigger 也早就跳過了，
        // 沒必要為一筆不會被記次的更新擋下當事人。
        return next != 'rejected' || prev == 'rejected'
            || request.resource.data.get('lastActionBy', '') ==
               (request.auth.uid == resource.data.buyerId ? 'buyer' : 'seller');
      }

      // 維護期間只放行「取消」這一條出路。卡在一半的人要能自己結案，其他會
      // 推進交易狀態的寫入（接受、協商、安全交易、掃碼、成交、逾期關閉）全擋。
      // 管理員不受影響：orders.update 的 isAdmin() 分支在這條之前就放行了，
      // 維護期間仍然要有人能進去把壞掉的資料修好。
      function maintenanceAllows() {
        return !inMaintenance()
            || request.resource.data.get('status', '') == 'rejected';
      }

      // 成交價：只有買家能填（Deal.vue 的 price 步驟），只有賣家能退回成 null
      // （sellerConfirmPrice(false)），而且都必須發生在 accepted 階段。
      // 上限與 Deal.vue 的 MAX_PRICE 一致——那邊只是前端擋，繞過就能寫進天文
      // 數字，把排行榜的「循環利用金額」灌到失真。兩邊改動要同步。
      function finalPriceOk() {
        let stage = resource.data.get('status', '');
        let prev = resource.data.get('finalPrice', null);
        let next = request.resource.data.get('finalPrice', prev);
        return next == prev
            || (stage == 'accepted'
                && request.auth.uid == resource.data.buyerId
                && next is number && next > 0 && next <= 10000)
            || (stage == 'accepted'
                && request.auth.uid == resource.data.sellerId
                && next == null);
      }

      // 只有這筆訂單的買家、賣家、或管理員能看到／動到——原本任何登入者都能
      // 讀寫任何一筆訂單，等於別人的面交時間地點、價格全部攤在陽光下。
      allow read: if request.auth != null && (isParty() || isAdmin());

      // 建立時一定是買家本人發起（TradeModal.vue 一律把 buyerId 設成 auth.uid）。
      // buyerId != sellerId 這條原本也只在 TradeModal.vue 前端擋，繞過前端就能
      // 自買自賣，污染排行榜與貢獻度統計。
      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId != request.resource.data.sellerId
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('negotiationStep', 0) == 0
        && !('finalPrice' in request.resource.data)
        && request.resource.data.productId is string
        && request.resource.data.productId != ''
        && sellerOwnsProduct(request.resource.data.productId)
        && notTradeBanned()
        && !inMaintenance();

      allow update: if request.auth != null && (
        isAdmin()
        || (isParty() && immutablePartiesKept() && negotiationStepOk()
            && statusFlowOk() && finalPriceOk() && delayUsedOk()
            && cancelActorOk() && maintenanceAllows())
      );

      // 目前沒有任何地方會刪除訂單，不開放
      allow delete: if false;
    }

    match /favorites/{favId} {
      // 只有本人能看到／動到自己的收藏——原本任何登入者都能讀寫任何人的收藏清單
      allow read, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow update: if false; // 沒有地方會更新收藏，只有新增/刪除
    }

    match /notifications/{notifId} {
      // 一般人可讀（首頁公告）；建立/刪除限管理員（發/收公告）
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
    }

    // 評價。這裡是評分的唯一入口——users.ratingSum / ratingCount 已經禁止前端
    // 寫入，改由 Cloud Function onReviewCreated 監聽本 collection 累加，所以
    // 「能不能刷分」完全取決於下面這幾條能不能被繞過：
    //   1. 文件 id 固定為 `${orderId}_${raterId}`：一筆訂單每人只能評一次，
    //      重複送出會撞 id 而被 create 拒絕（不靠前端自律）
    //   2. stars 必須是 1..5 的整數，擋掉一次灌 99999 分
    //   3. 必須是「這筆 completed 訂單的當事人」評「對面那個人」，
    //      擋掉對陌生人評分、以及自己評自己
    match /reviews/{reviewId} {
      // 回頭查 orders：評分資格的真正判準在訂單，不在 reviews 自己的欄位。
      // orderId 用參數傳進來，路徑字面值才能維持在同一行。
      function ratingPairOk(orderId) {
        let o = get(/databases/$(database)/documents/orders/$(orderId)).data;
        let rater = request.resource.data.raterId;
        let rated = request.resource.data.ratedId;
        return o.status == 'completed'
            && ((rater == o.buyerId && rated == o.sellerId)
                || (rater == o.sellerId && rated == o.buyerId));
      }

      function orderExists(orderId) {
        return exists(/databases/$(database)/documents/orders/$(orderId));
      }

      allow create: if request.auth != null
        && request.resource.data.raterId == request.auth.uid
        && request.resource.data.ratedId != request.auth.uid
        && request.resource.data.orderId is string
        && reviewId == request.resource.data.orderId + '_' + request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && orderExists(request.resource.data.orderId)
        && ratingPairOk(request.resource.data.orderId)
        // 維護期間連互評也停：它會觸發 onReviewCreated 去改 users 的評分彙總，
        // 而緊急煞車的用意就是「先讓資料不要再變動」。訂單已經 completed，
        // 評分等維護結束再補得回來。
        && !inMaintenance();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 罐頭訊息（新交易流程的面交前即時協調）。訊息本身沒存買賣雙方 uid，
    // 靠 isOrderParty() 回頭查 orders 判斷讀寫資格——只有這筆訂單的買家/賣家
    // 能看到、能發言，原本任何登入者都能讀寫任何一筆訊息。
    match /messages/{messageId} {
      allow read: if request.auth != null && isOrderParty(resource.data.orderId);
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && isOrderParty(request.resource.data.orderId);

      // 原本是 update: if false。「希望推遲至 X 點面交」需要收訊的一方能回覆
      // 同意／婉拒，所以得開一條縫，範圍鎖到最小：
      //   - 只有訊息的「收件者」（訂單當事人、且不是發送者本人）能改
      //     ——否則發送者可以自己同意自己的推遲請求
      //   - 只准動 requestStatus 一個欄位
      //     ——否則能先發「推遲到 15:00」，等對方同意後再把 proposedTime
      //       偷改成別的時間，對方畫面上的同意紀錄就對不上實際改成的時間
      //   - 只能從 pending 出發，且終點限 accepted / declined
      //     ——回覆過就定案，不能反覆翻案
      allow update: if request.auth != null
        && isOrderParty(resource.data.orderId)
        && resource.data.senderId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['requestStatus'])
        && resource.data.get('requestStatus', '') == 'pending'
        && request.resource.data.requestStatus in ['accepted', 'declined'];

      allow delete: if false;
    }

    // 平台設定（目前只有 settings/trade，控制交易時段限制要不要強制）。
    // 一般使用者必須讀得到——TradeModal 依它決定要不要驗 06:00–18:00，讀不到
    // 就會退回「限制生效」，等於管理員關掉了卻沒人受惠。寫入限管理員。
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 廣告投放：首頁未登入也看得到（跟 products 一樣公開可讀），
    // 只有管理員能新增/修改/刪除廣告內容與上下架期限。
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
